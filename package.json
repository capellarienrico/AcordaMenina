{
  "name": "acorda-menina",
  "version": "1.0.0",
  "description": "Aplicativo de produtividade e alertas de reuniões em tela cheia com sincronização de múltiplos calendários Google, sem limites.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.capellarienrico.acordamenina",
    "productName": "AcordaMenina",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "calendar",
    "reminder",
    "fullscreen-alert",
    "in-your-face",
    "google-calendar",
    "meetings",
    "productivity"
  ],
  "author": "capellarienrico",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-ical": "^0.20.1"
  }
}
